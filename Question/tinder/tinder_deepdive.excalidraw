      "text": "Core Entity\n\nUser Profile\nSwipe\nMatch",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Core Entity\n\nUser Profile\nSwipe\nMatch",
      "autoResize": true,
      "lineHeight": 1.35
    },
    {
      "id": "T7-DwxH9PEzb2Z2MwiSMg",
      "type": "text",
      "x": 1792.8827027019577,
      "y": 8229.18935287161,
      "width": 387.43572998046875,
      "height": 793.8000000000001,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6m",
      "roundness": null,
      "seed": 1867058127,
      "version": 392,
      "versionNonce": 432040623,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1747355179587,
      "link": null,
      "locked": false,
      "text": "API\n- create profile\nPOST /users\n{\n    minAge\n    maxAge\n    preferGender\n    distance\n    age\n    gender\n}\n\n- get users\nGET /users?lat&long -> users[]\nHeader: JWT | session\n\n- swipe candidate -> match?\nPOST /swipes:userId\n{\n    decision: yes/no\n}",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "API\n- create profile\nPOST /users\n{\n    minAge\n    maxAge\n    preferGender\n    distance\n    age\n    gender\n}\n\n- get users\nGET /users?lat&long -> users[]\nHeader: JWT | session\n\n- swipe candidate -> match?\nPOST /swipes:userId\n{\n    decision: yes/no\n}",
      "autoResize": true,
      "lineHeight": 1.35
    },
