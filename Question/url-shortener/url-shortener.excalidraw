      "updated": 1747180945001,
      "link": null,
      "locked": false,
      "text": "7 numeric digit URLs:\n10^7 combinations < 1 Billion = 10^9\n\nbase64 URL hashing:\n64^7 > 10^9",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "7 numeric digit URLs:\n10^7 combinations < 1 Billion = 10^9\n\nbase64 URL hashing:\n64^7 > 10^9",
      "autoResize": true,
      "lineHeight": 1.35
    },
    {
      "id": "k-C0ZNWzh4T9e-hBJymiE",
      "type": "text",
      "x": 3019.723440255476,
      "y": 10010.650627601917,
      "width": 830.8993530273438,
      "height": 189.00000000000003,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6Y",
      "roundness": null,
      "seed": 1162263821,
      "version": 339,
      "versionNonce": 1338344109,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1747181004667,
      "link": null,
      "locked": false,
      "text": "Hashing Strategy:\n1. Randomize: need to check for duplicate, DB call.\n2. URL hashing: need to check for duplicate, DB call.\n3. Counter: guarantee no duplicate, but need to sync on the count.\n",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Hashing Strategy:\n1. Randomize: need to check for duplicate, DB call.\n2. URL hashing: need to check for duplicate, DB call.\n3. Counter: guarantee no duplicate, but need to sync on the count.\n",
      "autoResize": true,
      "lineHeight": 1.35
    },
